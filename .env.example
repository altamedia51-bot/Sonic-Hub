# GEMINI_API_KEY: Optional for additional features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for KIE webhook callbacks and self-referential links.
APP_URL="MY_APP_URL"
PUBLIC_APP_URL="MY_APP_URL"

# KIE_ENCRYPTION_KEY: 32-byte secret key (in hex, 64 chars) for AES-256-GCM encryption of KIE API keys
KIE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# PERSIST_GENERATED_AUDIO: Whether to persist remote KIE audio files to storage (true/false)
PERSIST_GENERATED_AUDIO="false"

